# ── LLM providers ────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...          # Fallback key; per-user BYOK takes precedence
GEMINI_API_KEY=                       # Optional

# ── Existing pipeline credentials ────────────────────────────────────────────
NCBI_EMAIL=you@example.com
NCBI_API_KEY=

# ── Web platform ──────────────────────────────────────────────────────────────
# Generate JWT secret:  openssl rand -hex 32
JWT_SECRET=

# Generate Fernet key:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
# GitHub OAuth App — create at https://github.com/settings/applications/new
# Callback URL: http://localhost:8000/auth/callback (dev) or https://yourdomain.com/auth/callback (prod)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Redis broker for Celery
REDIS_URL=redis://localhost:6379/0

# React dev server or production URL
FRONTEND_URL=http://localhost:5173

# Set to "production" to disable /docs
ENV=development
