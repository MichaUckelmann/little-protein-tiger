# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# If you're behind a corporate TLS-inspecting proxy, you may also need to
# set REQUESTS_CA_BUNDLE / CURL_CA_BUNDLE to your system's CA bundle so
# Python's requests library can verify HTTPS connections. That's a
# workstation-specific workaround, not a general requirement, so no
# placeholder is templated here.

# Anthropic API key. Required for curation (curate_papers.py) and for
# CLI skills run with --model claude.
ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini API key. Required for CLI skills run with --model gemini.
GEMINI_API_KEY=...

# Email address for NCBI E-utilities (PubMed/PMC) requests. Required for
# polite crawling — NCBI asks for this and rate-limits unidentified traffic.
NCBI_EMAIL=you@example.com

# NCBI API key. Optional — raises the NCBI rate limit if provided.
NCBI_API_KEY=

# Semantic Scholar API key. Optional — raises the rate limit for S2 bulk
# search from ~1 req/s to 10 req/s.
S2_API_KEY=
