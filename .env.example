# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# If you're behind a corporate TLS-inspecting proxy (FortiGate, Zscaler,
# Netskope, ...), set LPT_CA_BUNDLE to a bundle that contains your proxy's
# root CA — usually the system bundle, which certifi does NOT include:
#
#   LPT_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt     # Debian/Ubuntu
#   LPT_CA_BUNDLE=/etc/pki/tls/certs/ca-bundle.crt       # RHEL/Fedora
#
# Set this ONE variable and nothing else. `src/env_config.load_env()` fans it
# out to SSL_CERT_FILE, REQUESTS_CA_BUNDLE and CURL_CA_BUNDLE, which are not
# interchangeable: `requests` reads REQUESTS_CA_BUNDLE and otherwise defaults
# to certifi, while `httpx` — which the anthropic SDK and huggingface_hub are
# both built on — ignores it and honours only SSL_CERT_FILE. Setting just
# REQUESTS_CA_BUNDLE fixes half the stack: the Gemini call succeeds and
# curation then dies in the vector-ingest hook with CERTIFICATE_VERIFY_FAILED
# while fetching the embedding model.
#
# Workstation-specific, not a general requirement — leave unset off a
# corporate network, where certifi's defaults are correct.
#
# On Python 3.13+ a TLS-inspecting proxy can fail differently, with
# "CERTIFICATE_VERIFY_FAILED: Missing Authority Key Identifier". A CA bundle
# does NOT fix that one: 3.13 turns on ssl.VERIFY_X509_STRICT, which enforces
# RFC 5280 structural rules many proxies break when they re-sign a certificate.
# Setting this clears that ONE flag. Trust-chain, hostname and expiry checking
# all still apply (verified against badssl.com) — only the structural pedantry
# is dropped, which is what Python 3.12, curl and browsers already do.
# LPT_SSL_RELAX_STRICT=1

# Anthropic API key. Optional. Selects the Claude path with --provider claude,
# or routes one stage there via models.<provider>.stages in config.yaml.
# Nothing reaches for it automatically: a stage a safety classifier declines
# ENDS THE RUN, and re-running on another model is your decision (see
# docs/responsible-use.md). NOT needed for curation — that follows the
# pipeline default and runs on gemini.
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (Responses API). Optional — only needed for --provider openai. Replace
# the placeholder gpt-5.6-* rates in config.yaml with your account's before
# relying on --budget.
OPENAI_API_KEY=

# Google Gemini API key. Required for CLI skills run with --model gemini.
GEMINI_API_KEY=...

# Email address for NCBI E-utilities (PubMed/PMC) requests. Required for
# polite crawling — NCBI asks for this and rate-limits unidentified traffic.
NCBI_EMAIL=you@example.com

# NCBI API key. Optional — raises the NCBI rate limit if provided.
NCBI_API_KEY=

# Semantic Scholar API key. Optional — raises the rate limit for S2 bulk
# search from ~1 req/s to 10 req/s.
S2_API_KEY=

# ── Binder-design compute environment (optional — only the binder/design ───
# track needs these; the literature corpus pipeline and CLI skills work
# without any of them). Each is machine-specific and MUST NOT be set in the
# tracked config.yaml — that's why these live here instead. Every one is
# optional: unset, the pipeline either falls back to a PATH lookup or fails
# with a clear error naming exactly which env var (or config.yaml key) to
# set, only at the point that specific tool is actually needed. See
# docs/environment_setup.md for the full story, including the SLURM-cluster
# staging path and what a compatible cluster pipeline needs to look like.

# Absolute path to your BoltzGen entry point (its shebang carries its own
# venv's Python, so no `conda activate`/`uv run` needed). See BoltzGen's own
# README for installation.
LPT_BOLTZGEN_EXECUTABLE=

# Absolute path to the python of a conda/venv env with PyRosetta installed
# (PyRosetta's ABI is usually incompatible with the main LPT venv's Python,
# hence the separate env). See docs/pyrosetta_setup.md.
LPT_PYROSETTA_PYTHON=

# Absolute path to a foundry (RFD3 / RF3 / solubleMPNN) checkout — the
# directory containing its own GPU-specific venv. See its own setup docs;
# the exact venv name/CUDA build is GPU-generation-specific (this repo's
# reference setup needed a custom build for a Blackwell card).
LPT_FOUNDRY_ROOT=

# The model weights, if they are not in foundry's default ~/pip_rcfoundry_ckpt
# (a shared lab volume, say). Leave blank to use that default.
LPT_FOUNDRY_CKPT_DIR=

# Absolute path to a `binder_pipeline`-shaped checkout reachable from this
# machine (read/write for staging — its own scripts run on a SLURM cluster
# this machine cannot reach directly). Only needed for --compute cluster.
# See docs/environment_setup.md for the contract a compatible pipeline must
# satisfy.
LPT_CLUSTER_PIPELINE_ROOT=

# Absolute path to a separate Protenix checkout, used only to fetch a target
# MSA for the cluster refold path via its own hosted MMseqs2 search.
LPT_CLUSTER_PROTENIX_REPO=

# Multi-line free text shown verbatim in the cluster pause instructions
# (login node, how to reach pipeline_root from there). A real value needs
# quotes to preserve the newlines, e.g.:
#   LPT_CLUSTER_SUBMIT_INSTRUCTIONS="ssh cluster.example.org
#   cd /shared/binder_pipeline"
LPT_CLUSTER_SUBMIT_INSTRUCTIONS=

# Reference campaign used by ~13 tests (real RFD3 sidecars + RF3 confidences).
# Maintainer-only; the tests skip cleanly when it is absent, as they do in CI.
# LPT_BCR_REFERENCE_DIR=/path/to/BCR
